{
  "name": "tsoa-koa-hexagonal-todo",
  "version": "1.0.0",
  "description": "Full fledged Koa backend with TSOA and Hexagonal Architecture for Todo List",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run tsoa:generate && tsc",
    "tsoa:generate": "tsoa spec-and-routes",
    "tsoa:routes": "tsoa routes",
    "tsoa:spec": "tsoa spec",
    "dev": "concurrently \"tsoa spec-and-routes --watch\" \"ts-node-dev --respawn --transpile-only src/server.ts\"",
    "start": "node dist/server.js"
  },
  "keywords": [
    "tsoa",
    "koa",
    "typescript",
    "hexagonal-architecture",
    "rest-api",
    "openapi",
    "swagger"
  ],
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.0.1",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa2-swagger-ui": "^5.10.0",
    "tsoa": "^6.2.1"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/node": "^20.14.9",
    "concurrently": "^8.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
